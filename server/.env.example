# Server configuration - copy to .env and fill in real values.
# NEVER commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB connection (local Docker by default, or your Atlas URI)
MONGODB_URI=mongodb://localhost:27017/flynest_consultancy

# Auth - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma separated list of allowed origins
CORS_ORIGIN=http://localhost:5174

# SMTP (optional - emails are logged to the console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FlyNest Overseas Consultancy <no-reply@example.com>"
ADMIN_NOTIFY_EMAIL=

# Seeded admin account (used by `npm run seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
